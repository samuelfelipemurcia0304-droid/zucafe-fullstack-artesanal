# Copia este archivo y llámalo ".env" (con el punto al inicio). NUNCA subas el .env a GitHub.

PORT=3000

# Conexión a MongoDB
#   En tu computador:  mongodb://127.0.0.1:27017/zucafe
#   En internet (Atlas): mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/zucafe?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/zucafe

# Usuario y contraseña para entrar al panel admin (cámbialos)
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave

# Texto largo cualquiera, sirve para firmar las sesiones del admin
JWT_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# OPCIONAL: si tienes una clave de Claude (Anthropic), el chatbot responde con IA real.
# Si la dejas vacía, el chatbot usa sus respuestas programadas y funciona igual.
ANTHROPIC_API_KEY=
